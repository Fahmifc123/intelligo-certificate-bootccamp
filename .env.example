# Copy this file to .env.local for local development and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# --- Authentication (required) ---
# Single shared admin password used to log into this internal tool.
# Choose a long, random, unique password - this gates access to all
# participant data (names, emails, scores, invoices, payment info).
ADMIN_PASSWORD=

# Random secret used to sign session cookies (HMAC-SHA256). Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Random secret that lets the server's own Puppeteer PDF renderer load the
# internal /print/* pages without a login cookie. Generate with:
#   openssl rand -hex 24
INTERNAL_RENDER_SECRET=

# --- Public certificate verification (optional) ---
# If set, GET /api/public/verify/[id] requires this value in the
# X-Verify-Key header. Leave unset to allow unauthenticated verification
# lookups (the endpoint never returns sensitive fields either way).
# Generate with: openssl rand -hex 24
CERTIFICATE_VERIFY_KEY=

# --- Database (optional but required for history/verification/revocation) ---
# Postgres connection string (e.g. Vercel Postgres / Neon).
DATABASE_URL=

# --- Email (required to send certificates/invoices/receipts) ---
RESEND_API_KEY=
EMAIL_FROM="Intelligo ID <noreply@yourdomain.com>"
